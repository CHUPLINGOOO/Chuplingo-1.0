# This is a generic Gradle launcher for Unix-like systems.
# It is generated by Gradle and should not be edited.

# Attempt to find the JVM
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
elif [ -n "$JAVACMD" ] ; then
    # JAVACMD is set, use it
    :
else
    # Try to find java
    JAVACMD="java"
fi

# Check if java is available
if ! command -v "$JAVACMD" > /dev/null 2>&1 ; then
    echo "Error: Java is not available in the PATH."
    echo "Please install a JDK (version 11 or higher) and make sure it is in your PATH."
    exit 1
fi

# Check if JAVA_HOME is set
if [ -z "$JAVA_HOME" ] ; then
    # Try to find JAVA_HOME from java
    JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
    export JAVA_HOME
fi

# Set the Gradle wrapper properties
APP_HOME=$(cd $(dirname $0) && pwd)
cd "$APP_HOME"

# Run Gradle
exec "$JAVACMD" -classpath "gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"